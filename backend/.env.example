# Supabase
SUPABASE_URL=https://txagiueetqbnvkjkwrbr.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Database (Direct Pooling)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.txagiueetqbnvkjkwrbr.supabase.co:5432/postgres

# Database (Transaction Pooler)
DATABASE_URL_POOL=postgresql://postgres.txagiueetqbnvkjkwrbr:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Server
PORT=3000
NODE_ENV=development

# Security
# Comma-separated allowlist of origins allowed to call this API.
# Example: CORS_ORIGINS=http://localhost:5173,https://tci.example.com
CORS_ORIGINS=http://localhost:5173
# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
