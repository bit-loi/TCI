{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"rewrites": [
		{
			"source": "/api/overpass",
			"destination": "https://maps.mail.ru/osm/tools/overpass/api/interpreter"
		},
		{
			"source": "/api/:path*",
			"destination": "https://tci-xfmj.vercel.app/api/:path*"
		},
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}
